<view class="page settings-page">
  <view class="settings-header">
    <text class="title">服务器配置</text>
    <text class="config-state {{configured ? 'is-configured' : ''}}">{{configured ? '已有配置' : '未配置'}}</text>
  </view>

  <view class="access-panel">
    <view class="field">
      <label class="field-label" for="server">服务器域名</label>
      <input id="server" class="credential" type="text" value="{{server}}" maxlength="265"
        placeholder="https://rc.example.com" placeholder-class="credential-placeholder" bindinput="onServerInput" />
    </view>
    <view class="field">
      <label class="field-label" for="access">私有链接或访问密钥</label>
      <input id="access" class="credential" type="text" password value="{{access}}" maxlength="380"
        placeholder="{{configured ? '留空沿用当前服务器的密钥' : '粘贴完整遥控链接或输入密钥'}}"
        placeholder-class="credential-placeholder" confirm-type="done" bindinput="onAccessInput" bindconfirm="save" />
      <text class="field-hint">粘贴完整遥控链接可同时填充域名和密钥。</text>
    </view>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </view>
  <view class="access-panel connection-panel">
    <label class="connection-option" for="direct-only">
      <view>
        <text class="connection-label">仅 P2P 直连</text>
        <text class="field-hint">{{directOnly ? '直连失败时会提示重试。' : '优先直连，失败后使用 TURN 中继。'}}</text>
      </view>
      <switch id="direct-only" checked="{{directOnly}}" color="#086b56" bindchange="onDirectOnlyChange" />
    </label>
  </view>
  <button class="action save-action" bindtap="save"><text class="action-icon" aria-hidden="true">✓</text>保存并连接</button>
  <text class="footnote">配置仅保存在本机，自建域名需通过微信业务域名验证。</text>
</view>
