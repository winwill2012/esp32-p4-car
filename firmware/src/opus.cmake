set(opus_version 1.5.2)
set(opus_cache "${CMAKE_CURRENT_LIST_DIR}/../.pio/vendor")
set(opus_root "${opus_cache}/opus-${opus_version}")
set(opus_tar "${opus_cache}/opus-${opus_version}.tar.gz")
set(opus_sha 9480e329e989f70d69886ded470c7f8cfe6c0667cc4196d4837ac9e668fb7404)

if(NOT EXISTS "${opus_root}/opus_sources.mk")
    file(MAKE_DIRECTORY "${opus_cache}")
    if(EXISTS "${opus_tar}")
        file(SHA256 "${opus_tar}" opus_download_sha)
    endif()
    if(NOT opus_download_sha STREQUAL opus_sha)
        file(DOWNLOAD "https://codeload.github.com/xiph/opus/tar.gz/refs/tags/v${opus_version}"
            "${opus_tar}" EXPECTED_HASH SHA256=${opus_sha} TLS_VERIFY ON TIMEOUT 220)
    endif()
    file(ARCHIVE_EXTRACT INPUT "${opus_tar}" DESTINATION "${opus_cache}")
endif()

function(opus_read_sources makefile variable destination)
    file(READ "${opus_root}/${makefile}" source_lists)
    string(REPLACE "\\\r\n" " " source_lists "${source_lists}")
    string(REPLACE "\\\n" " " source_lists "${source_lists}")
    string(REGEX MATCH "(^|\n)${variable}[ \t]*:?=[^\r\n]*" source_list "${source_lists}")
    string(REGEX MATCHALL "[A-Za-z0-9_./-]+\\.c" paths "${source_list}")
    if(NOT paths)
        message(FATAL_ERROR "No sources found for ${variable}")
    endif()
    list(TRANSFORM paths PREPEND "${opus_root}/")
    set(${destination} ${paths} PARENT_SCOPE)
endfunction()

opus_read_sources(opus_sources.mk OPUS_SOURCES opus_main_sources)
opus_read_sources(celt_sources.mk CELT_SOURCES opus_celt_sources)
opus_read_sources(silk_sources.mk SILK_SOURCES opus_silk_sources)
opus_read_sources(silk_sources.mk SILK_SOURCES_FIXED opus_fixed_sources)
